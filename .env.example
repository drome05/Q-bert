# This file is a consolidated reference of every value used anywhere across
# the 7 services (gateway/, services/*/) -- it doesn't map to a single
# running process anymore. In production each value goes into a specific
# namespace's K8s secret (see README's Deployment section); this file is
# mainly useful as the source for the `kubectl create secret` commands and
# for running one service locally in isolation.
DISCORD_BOT_TOKEN=your_bot_token_here
HENRIKDEV_API_KEY=your_henrikdev_key_here
GUILD_ID=your_server_id_here          # for instant slash command sync during dev
VALORANT_UPDATES_CHANNEL_ID=channel_id_here

# Optional (all have defaults if unset)
INHOUSE_STAFF_ROLE_ID=role_id_here            # pinged on disputed matches
INHOUSE_VOICE_CATEGORY_ID=category_id_here    # where temp match voice channels are created
DB_PATH=data/bot.db                           # local dev override; prod uses /app/data/bot.db

# Optional -- Twitch live announcements are disabled until both are set.
# Get these free at https://dev.twitch.tv/console/apps (see README for steps).
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here
